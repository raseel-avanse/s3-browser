# Database Configuration
DATABASE_URL="postgresql://s3admin:s3secure_password_change_me@localhost:5432/s3browser"

# NextAuth / Session Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Encryption Key for AWS Credentials (generate with: openssl rand -base64 32)
# IMPORTANT: Keep this secret! If lost, encrypted data cannot be recovered.
ENCRYPTION_KEY="your-encryption-key-here-change-this"

# Optional: Override default admin credentials
# DEFAULT_ADMIN_USERNAME="admin"
# DEFAULT_ADMIN_PASSWORD="admin"

# Optional: S3 Configuration for logo storage
# LOGO_S3_BUCKET=""
# LOGO_S3_REGION=""
# LOGO_AWS_ACCESS_KEY_ID=""
# LOGO_AWS_SECRET_ACCESS_KEY=""

# Optional: Active Directory / LDAP Authentication
# Set LDAP_HOST and LDAP_BASE_DN to enable LDAP auth alongside local accounts.
# Run `node scripts/migrate-ldap.js` after enabling for the first time.
# LDAP_HOST="dc.company.com"
# LDAP_PORT="389"                              # Optional; use 636 for LDAPS (TLS)
# LDAP_BASE_DN="DC=company,DC=com"
# LDAP_BIND_DN="CN=svc-s3browser,CN=Users,DC=company,DC=com"   # Optional service account DN
# LDAP_BIND_PASSWORD="service-account-password"                 # Required when LDAP_BIND_DN is set
